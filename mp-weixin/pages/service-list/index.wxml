<view class="service-list-page">
  <view class="hero-card">
    <view class="hero-title">无人机低空综合服务</view>
    <view class="hero-subtitle">覆盖物流、培训、研学等12类服务场景</view>
    <view class="hero-tip">请选择需要的服务类型</view>
  </view>

  <view
    class="service-card"
    wx:for="{{services}}"
    wx:for-item="item"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="handleServiceTap"
  >
    <view class="card-header">
      <view class="service-icon" style="background: {{item.color}}">
        <text>{{item.icon}}</text>
      </view>
      <view class="service-info">
        <view class="service-name">{{item.name}}</view>
        <view class="service-slogan">{{item.slogan}}</view>
      </view>
      <text class="service-arrow">›</text>
    </view>
    <view class="service-tags">
      <view class="service-tag" wx:for="{{item.projects}}" wx:for-item="tag" wx:key="name">
        {{tag.name}}
      </view>
    </view>
  </view>
</view>

