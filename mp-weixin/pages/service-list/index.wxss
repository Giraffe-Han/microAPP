.service-list-page {
  padding-bottom: 40rpx;
}

.hero-card {
  margin: 32rpx;
  padding: 48rpx;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #2563eb 0%, #9333ea 100%);
  box-shadow: 0 30rpx 60rpx rgba(37, 99, 235, 0.25);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.85;
  margin-bottom: 16rpx;
}

.hero-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

.service-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1);
}

.service-info {
  flex: 1;
}

.service-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.service-slogan {
  font-size: 24rpx;
  color: #646566;
  margin-top: 4rpx;
}

.service-arrow {
  font-size: 48rpx;
  color: #c8c9cc;
}

.service-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.service-tag {
  padding: 8rpx 20rpx;
  border-radius: 32rpx;
  background: #f2f3f5;
  font-size: 22rpx;
  color: #646566;
}

