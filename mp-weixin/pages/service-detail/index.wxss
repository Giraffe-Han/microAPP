.service-detail-page {
  padding-bottom: 160rpx;
}

.service-header {
  background: #fff;
  text-align: center;
  padding: 48rpx 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.04);
}

.service-icon-big {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 72rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.12);
}

.service-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.service-slogan {
  font-size: 26rpx;
  color: #969799;
}

.section-text {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.8;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.project-item {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #323233;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}

.project-icon {
  font-size: 32rpx;
}

.advantage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advantage-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #646566;
}

.advantage-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
}

.training-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  font-size: 26rpx;
  color: #646566;
}

.price-list {
  display: flex;
  flex-direction: column;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px dashed #ebedf0;
}

.price-item:last-child {
  border-bottom: none;
}

.price-item .label {
  font-size: 26rpx;
  color: #323233;
}

.price-item .price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ee0a24;
}

.feature-item {
  margin-bottom: 20rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #646566;
  line-height: 1.7;
}

.showcase-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.showcase-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}

.showcase-image {
  width: 200rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fff;
}

.showcase-image image {
  width: 100%;
  height: 100%;
}

.showcase-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.showcase-title {
  font-size: 28rpx;
  font-weight: 600;
}

.showcase-desc {
  font-size: 24rpx;
  color: #646566;
  line-height: 1.6;
}

.company-intro .intro-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.license-intro .law-quote {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #646566;
  line-height: 1.6;
}

.contact-card {
  text-align: center;
}

.contact-info text {
  display: block;
  font-size: 26rpx;
  color: #646566;
  margin-bottom: 12rpx;
}

.phone-link {
  font-size: 36rpx;
  font-weight: 600;
}

.address {
  line-height: 1.6;
}

.work-time {
  font-size: 24rpx;
  color: #969799;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 40rpx;
  background: #fff;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.apply-btn {
  width: 100%;
  border: none;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

