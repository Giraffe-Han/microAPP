<view class="apply-page" wx:if="{{service}}">
  <view class="section-card apply-hero">
    <view class="hero-title">{{service.name}}</view>
    <view class="hero-slogan">{{service.slogan}}</view>
    <view class="hero-desc">{{service.intro}}</view>
  </view>

  <view class="section-card form-card">
    <view class="form-item">
      <view class="form-label">联系人</view>
      <input
        placeholder="请输入姓名"
        value="{{form.name}}"
        data-field="name"
        bindinput="handleInput"
      />
    </view>
    <view class="form-item">
      <view class="form-label">联系电话</view>
      <input
        placeholder="请输入手机号"
        value="{{form.phone}}"
        data-field="phone"
        type="number"
        bindinput="handleInput"
        maxlength="11"
      />
    </view>
    <view class="form-item">
      <view class="form-label">所属单位</view>
      <input
        placeholder="公司/机构/学校"
        value="{{form.company}}"
        data-field="company"
        bindinput="handleInput"
      />
    </view>
    <view class="form-item">
      <view class="form-label">需求说明</view>
      <textarea
        placeholder="请描述具体业务需求、预期时间等"
        value="{{form.demand}}"
        data-field="demand"
        bindinput="handleInput"
      />
    </view>
  </view>

  <view class="submit-bar">
    <button class="submit-btn" style="background: {{service.color}}" bindtap="handleSubmit">提交申请</button>
  </view>
</view>

