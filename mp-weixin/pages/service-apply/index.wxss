.apply-page {
  padding-bottom: 160rpx;
}

.apply-hero {
  margin-top: 32rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hero-slogan {
  font-size: 28rpx;
  color: #fa6400;
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.7;
}

.form-card {
  margin-top: 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #323233;
  margin-bottom: 12rpx;
}

input,
textarea {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f7f8fa;
  border: 1px solid transparent;
  font-size: 26rpx;
}

textarea {
  min-height: 200rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx 40rpx;
  background: #fff;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  color: #fff;
  border: none;
  font-size: 32rpx;
  border-radius: 999rpx;
}

