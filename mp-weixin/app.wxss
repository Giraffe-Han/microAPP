page {
  min-height: 100%;
  background: #f5f5f5;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #323233;
}

view,
text {
  box-sizing: border-box;
}

.section-card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 24rpx 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  padding-left: 20rpx;
  border-left: 8rpx solid #1677ff;
  margin-bottom: 24rpx;
}

